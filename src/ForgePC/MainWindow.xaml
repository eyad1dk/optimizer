<DataTemplate x:Key="Page-Network"><StackPanel Tag="Page-Network" DataContext="{Binding DataContext,RelativeSource={RelativeSource AncestorType=Window}}"><Button Content="{Binding Actions.DnsLabel}" Command="{Binding Actions.FlushDns}" HorizontalAlignment="Left"/><ContentControl Content="{Binding}" ContentTemplate="{StaticResource ActionDetails}"/><TextBlock Text="Endpoint hostname or IP" Margin="0,12,0,4"/><DockPanel><Button Content="Measure ping" Command="{Binding MeasureNetwork}"/><TextBox Text="{Binding Endpoint,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Ping endpoint"/></DockPanel><TextBlock Text="{Binding NetworkResult}" Style="{StaticResource MutedText}"/><WrapPanel><Button Content="Test DNS lookup" Command="{Binding RunMaintenance}" CommandParameter="dns-test"/><Button Content="Measure gateway" Command="{Binding RunMaintenance}" CommandParameter="gateway"/><Button Content="Renew DHCP" Command="{Binding RunMaintenance}" CommandParameter="renew"/><Button Content="Release DHCP" Command="{Binding RunMaintenance}" CommandParameter="release"/><Button Content="Restore EZoptimizer network changes" Command="{Binding RunMaintenance}" CommandParameter="restore-network"/></WrapPanel><ContentControl Content="{Binding}" ContentTemplate="{StaticResource MaintenanceOutput}"/><ContentControl Content="{Binding}" ContentTemplate="{StaticResource NativeRows}"/><Expander Header="Custom IPv4 DNS"><StackPanel><TextBlock Text="1–4 DNS addresses, separated by commas. IPv6 is preserved."/><TextBox Text="{Binding CustomDns,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Custom IPv4 DNS"/><Button Content="Apply custom DNS" Command="{Binding ApplyCustomDns}" HorizontalAlignment="Left"/></StackPanel></Expander><ContentControl Content="{Binding}" ContentTemplate="{StaticResource FeatureBody}"/></StackPanel></DataTemplate>
