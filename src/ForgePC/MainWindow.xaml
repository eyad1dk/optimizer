scan"/><Button Content="Empty Recycle Bin" Command="{Binding RunMaintenance}" CommandParameter="bin-clean"/><Button Content="Inspect Delivery Optimization" Command="{Binding RunMaintenance}" CommandParameter="delivery-scan"/><TextBlock Text="Delivery cleanup: unsupported · use Windows Storage" Style="{StaticResource MutedText}"/></WrapPanel><ContentControl Content="{Binding}" ContentTemplate="{StaticResource MaintenanceOutput}"/><ContentControl Content="{Binding}" ContentTemplate="{StaticResource FeatureBody}"/></StackPanel></DataTemplate>
<DataTemplate x:Key="Page-Startup"><StackPanel Tag="Page-Startup" DataContext="{Binding DataContext,RelativeSource={RelativeSource AncestorType=Window}}"><TextBlock Text="Current-user Run entries. Entries move to a preserved disabled registration; recovery restores exact data and type. Publisher and startup impact are not inferred." Style="{StaticResource MutedText}"/><Button Content="Refresh entries" Command="{Binding Tools.RefreshStartup}"/><Button Content="Inspect all startup sources" Command="{Binding RunMaintenance}" CommandParameter="startup-info" HorizontalAlignment="Left"/><ContentControl Content="{Binding}" ContentTemplate="{StaticResource MaintenanceOutput}"/><TextBlock Text="{Binding Tools.StartupSummary}" Style="{StaticResource MutedText}"/><ItemsControl ItemsSource="{Binding Tools.StartupEntries}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Row}"><DockPanel><Button DockPanel.Dock="Right" Content="Enable" Command="{Binding DataContext.Tools.RestoreStartup,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding CanRestore,Converter={StaticResource BoolVisibility}}"/><Button DockPanel.Dock="Right" Content="Disable" Command="{Binding DataContext.Tools.DisableStartup,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding CanDisable,Converter={StaticResource BoolVisibility}}"/><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding State}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Value}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}"/></StackPanel></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><ContentControl Content="{Binding}" ContentTemplate="{StaticResource FeatureBody}"/></StackPanel></DataTemplate>
<DataTemplate x:Key="Page-Gaming"><StackPanel Tag="Page-Gaming" DataContext="{Binding DataContext,RelativeSource={RelativeSource AncestorType=Window}}"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource NativeRows}"/><ContentControl Content="{Binding}" ContentTemplate="{StaticResource FeatureBody}"/><Expander Header="Game library and automatic profiles"><StackPanel><ComboBox ItemsSource="{Binding SavedGames}" SelectedItem="{Binding SelectedSavedGame}" DisplayMemberPath="Name"/><TextBlock Text="{Binding SelectedSavedGame.Profile}"/><WrapPanel><Button Content="Add game" Command="{Binding AddGame}"/><Button Content="Review profile" Command="{Binding StageGame}"/><Button Content="Launch" Command="{Binding LaunchGame}"/><Button Content="Arm profile" Command="{Binding ArmGame}"/><Button Content="Disarm" Command="{Binding DisarmGame}"/><Button Content="Remove from library" Command="{Binding RemoveGame}"/></WrapPanel></StackPanel></Expander></StackPanel></DataTemplate>
<DataTemplate x:Key="Page-Profiles"><StackPanel Tag="Page-Profiles" DataContext="{Binding DataContext,RelativeSource={RelativeSource AncestorType=Window}}"><ItemsControl ItemsSource="{Binding ProfileRows}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Row}"><DockPanel><Button DockPanel.Dock="Right" Content="Review and apply" Command="{Binding DataContext.ApplyProfileNow,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Name}"/><StackPanel><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="{Binding Count,StringFormat={}{0} settings · availability checked before applying}" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Expander Header="Custom profile / game session"><StackPanel><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile}"/><WrapPanel><Button Content="Load for review" Command="{Binding StageProfile}"/><Button Content="Import" Command="{Binding Import}"/><Button Content="Export queue" Command="{Binding Export}"/><Button Content="Refresh running apps" Command="{Binding RefreshDiagnostics}"/></WrapPanel><TextBlock Text="{Binding ProfileAssessment}"/><ComboBox ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedGame}" DisplayMemberPath="Display"/><ComboBox ItemsSource="{Binding PriorityChoices}" SelectedItem="{Binding Priority}"/><WrapPanel><Button Content="Apply priority" Command="{Binding ApplyPriority}"/><Button Content="Restore priorities" Command="{Binding RestorePriorities}"/><Button Content="Start reviewed game session" Command="{Binding StartGame}"/></WrapPanel></StackPanel></Expander><Expander Header="{Binding QueueTitle}" IsExpanded="{Binding QueueExpanded}"><StackPanel><ItemsControl ItemsSource="{Binding Review}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Title,Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding Before,Mode=OneWay}"/><Run Text=" → "/><Run Text="{Binding After,Mode=OneWay}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><WrapPanel><Button Content="Preview" Command="{Binding Preview}"/><Button Content="Apply reviewed" Command="{Binding Apply}"/><Button Content="Cancel batch" Command="{Binding Cancel}"/><Button Content="Clear" Command="{Binding Clear}"/></WrapPanel></StackPanel></Expander></StackPanel></DataTemplate>
      <DataTemplate x:Key="Page-Diagnostics">
        <StackPanel Tag="Page-Diagnostics" DataContext="{Binding DataContext,RelativeSource={RelativeSource AncestorType=Window}}">
          <WrapPanel>
            <Button Content="Refresh inventories" Command="{Binding RefreshDiagnostics}" Style="{StaticResource Primary}" />
            <Button Content="Review export" Command="{Binding ExportReport}" />
          </WrapPanel>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Gaming readiness" Style="{StaticResource Heading}"/><TextBlock Text="{Binding Readiness}" Style="{StaticResource MutedText}"/><Button Content="Check display and power" Command="{Binding CheckReadiness}" HorizontalAlignment="Left"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Coding workspace" Style="{StaticResource Heading}"/><TextBlock Text="{Binding Workspace}" Style="{StaticResource MutedText}"/><Button Content="Inspect project folder" Command="{Binding ScanWorkspace}" HorizontalAlignment="Left"/></StackPanel></Border>
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FeatureBody}"/><TextBlock Text="Read-only inventories. Protected processes and packages may be absent; no app is automatically marked unnecessary." Style="{StaticResource MutedText}" />
          <Expander Header="Processes · accessible working sets">
            <ListBox ItemsSource="{Binding Processes}" DisplayMemberPath="Display" Height="240" AutomationProperties.Name="Accessible processes" />
          </Expander>
          <Expander Header="Startup · Run keys and startup folders">
            <StackPanel>
              <ListBox ItemsSource="{Binding Startup}" Height="200" AutomationProperties.Name="Partial startup inventory" />
              <Button Content="Manage startup in Windows" Command="{Binding Open}" CommandParameter="ms-settings:startupapps" />
            </StackPanel>
          </Expander>
          <Expander Header="Registered applications · user and machine scopes">
            <StackPanel>
              <ListBox ItemsSource="{Binding Apps}" DisplayMemberPath="Display" Height="240" AutomationProperties.Name="Registered applications" />
              <TextBlock Text="Partial uninstall-registry inventory. Framework/provisioned-package classification and removal are deferred. Windows provides the item-specific uninstall workflow; user data may be lost." />
              <Button Content="Open Windows installed apps" Command="{Binding Open}" CommandParameter="ms-settings:appsfeatures" />
            </StackPanel>
          </Expander>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Network · adapters and configured DNS" Style="{StaticResource Heading}" />
              <TextBlock Text="{Binding Network}" Style="{StaticResource MutedText}" />
              <TextBlock Text="Endpoint hostname or IP · five ICMP requests only when you click" />
              <TextBox Text="{Binding Endpoint,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Endpoint hostname or IP" />
              <Button Content="Measure selected endpoint" Command="{Binding MeasureNetwork}" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding NetworkResult}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Before / after · repeatable workload" Style="{StaticResource Heading}" />
              <TextBox Text="{Binding OptimizationFocus}" AutomationProperties.Name="Workload context" />
              <Button Content="Collect baseline / comparison" Command="{Binding Compare}" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding Comparison}" />
              <TextBlock Text="Game frame-time comparison" Style="{StaticResource Heading}" Margin="0,20,0,8"/>
              <TextBlock Text="CSV: FrameTimeMs or MsBetweenPresents, one process and swap chain. 1% low is 1000 divided by the mean of the slowest 1% of frame times." Style="{StaticResource MutedText}"/>
              <Button Content="Import baseline / comparison CSV" Command="{Binding ImportFrames}" HorizontalAlignment="Left"/>
              <TextBlock Text="{Binding Frames}"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="Page-Recovery &amp; History">
        <StackPanel Tag="Page-Recovery &amp; History" DataContext="{Binding DataContext,RelativeSource={RelativeSource AncestorType=Window}}">
          <WrapPanel><Button Content="Restore all recorded changes" Command="{Binding UndoAll}"/><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" AutomationProperties.Name="Recovery category"/><Button Content="Restore category" Command="{Binding UndoCategory}"/><Button Content="Restore process priorities" Command="{Binding RestorePriorities}"/><Button Content="Startup recovery" Command="{Binding Navigate}" CommandParameter="Startup"/></WrapPanel><Button Content="Restart PC" Command="{Binding RestartPc}" HorizontalAlignment="Left"/><Button Content="Restore Last Session" Command="{Binding UndoLatest}" HorizontalAlignment="Left"/><TextBlock Text="{Binding RecoverySummary}" Style="{StaticResource MutedText}" />
          <TextBlock Text="Review past sessions or restore your original preferences. Settings changed elsewhere are kept for your review." Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
          <Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource Surface}" CornerRadius="6" BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding History.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <StackPanel HorizontalAlignment="Center"><TextBlock Text="&#xE81C;" Style="{StaticResource Glyph}" Foreground="{DynamicResource Accent}" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,4"/><TextBlock Text="No saved setting changes" Style="{StaticResource Heading}" TextAlignment="Center"/><TextBlock Text="Your reviewed changes will appear here, with their original values and recovery details." Style="{StaticResource MutedText}" TextAlignment="Center" MaxWidth="360"/><Button Content="Profiles" Command="{Binding Navigate}" CommandParameter="Profiles" Style="{StaticResource Primary}" HorizontalAlignment="Center" Margin="0,12,0,0"/></StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding History}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{Binding Profile}" Style="{StaticResource Heading}" />
                    <TextBlock>
                      <Run Text="{Binding CreatedUtc,Mode=OneWay}" />
                      <Run Text=" · " />
                      <Run Text="{Binding Status,Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Id}" Style="{StaticResource MutedText}" FontSize="11" />
                    <Expander Header="Operation results">
                      <ItemsControl ItemsSource="{Binding Operations}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Margin="8">
                              <TextBlock>
                                <Run Text="{Binding Id,Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding State,Mode=OneWay}" />
                              </TextBlock>
                              <TextBlock>
                                <Run Text="{Binding Before,Mode=OneWay}" />
                                <Run Text=" → " />
                                <Run Text="{Binding Target,Mode=OneWay}" />
                              </TextBlock>
                              <TextBlock Text="{Binding Result}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding LastError}" Style="{StaticResource MutedText}"/><Button Content="Undo this setting" Command="{Binding DataContext.UndoSelected,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalAlignment="Left"/>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Expander>
                    <Button Content="Undo / retry exact restoration" Command="{Binding DataContext.Undo,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Expander Header="Recovery help"><TextBlock Text="Unreadable records are kept separately so valid sessions can still be restored. To open without dashboard probes, launch EZoptimizer.exe --recovery." Style="{StaticResource MutedText}"/></Expander>
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="Page-Settings">
        <StackPanel Tag="Page-Settings" DataContext="{Binding DataContext,RelativeSource={RelativeSource AncestorType=Window}}">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Appearance and session" Style="{StaticResource Heading}" />
              <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" AutomationProperties.Name="Color theme" />
              <TextBlock Text="Windows high contrast takes precedence. No interface animations. Windows DPI scaling is supported; all pages scroll at small sizes." />
              <TextBlock Text="Sleep behavior is managed in Windows Power settings." Style="{StaticResource MutedText}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="System Restore · supplementary" Style="{StaticResource Heading}" />
              <TextBlock Text="{Binding RestoreStatus}" />
              <WrapPanel>
                <Button Content="Inspect availability" Command="{Binding InspectRestore}" />
                <Button Content="Review restore-point creation" Command="{Binding CreateRestore}" />
                <Button Content="System Protection" Command="{Binding Open}" CommandParameter="protection" />
                <Button Content="Open Windows recovery" Command="{Binding Open}" CommandParameter="restore" />
              </WrapPanel>
              <TextBlock Text="Not a backup of personal files. The preference controls use exact journals and do not require a restore point." Style="{StaticResource MutedText}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Updates · official releases" Style="{StaticResource Heading}" />
              <CheckBox Content="Include preview releases" IsChecked="{Binding PreviewChannel}" />
              <WrapPanel>
                <Button Content="Check for updates" Command="{Binding CheckUpdate}" />
                <Button Content="Open official release page" Command="{Binding Open}" CommandParameter="https://github.com/eyad1dk/optimizer/releases" />
              </WrapPanel>
              <TextBlock Text="{Binding UpdateStatus}" />
              <TextBlock Text="Installation remains manual until publisher signing exists. A neighboring checksum checks integrity, not publisher identity. This preview is unsigned." Style="{StaticResource MutedText}" />
            </StackPanel>
          </Border>
          <Button Content="Open logs folder" Command="{Binding Tools.OpenLogs}" HorizontalAlignment="Left"/><TextBlock Text="No telemetry, account, background service or automatic uploads. Logs stay local with redacted operation results. Review reports before saving." />
        </StackPanel>
      </DataTemplate></ResourceDictionary></Window.Resources>
